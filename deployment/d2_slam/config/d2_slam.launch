<launch>
  <arg name="self_id" default="0"/>
  <arg name="main_id" default="1"/>
  <arg name="config" default="/repo/deployment/d2_slam/config/d2_slam.yaml"/>
  <arg name="output_path" default="/runtime/output"/>
  <arg name="lcm_uri" default="udpm://224.0.0.251:7667?ttl=1"/>

  <node pkg="d2vins" type="d2vins_node" name="d2vins" output="screen">
    <param name="self_id" value="$(arg self_id)" type="int"/>
    <param name="main_id" value="$(arg main_id)" type="int"/>
    <param name="vins_config_path" value="$(arg config)" type="string"/>
    <param name="output_path" value="$(arg output_path)" type="string"/>
    <param name="lcm_uri" value="$(arg lcm_uri)" type="string"/>
    <param name="enable_loop" value="true" type="bool"/>
    <param name="enable_network" value="true" type="bool"/>
    <param name="send_img" value="false" type="bool"/>
    <param name="send_whole_img_desc" value="false" type="bool"/>
    <param name="is_4dof" value="false" type="bool"/>
    <param name="show" value="false" type="bool"/>
    <param name="netvlad_model_path"
           value="/repo/src/basic_function/state_estimator/d2_slam/upstream/models/netvlad_series/mobilenetvlad_dyn_size.onnx"
           type="string"/>
  </node>

  <include file="$(find d2pgo)/launch/d2pgo.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="self_id" value="$(arg self_id)"/>
    <arg name="is_4dof" value="false"/>
  </include>
  <include file="$(find d2comm)/launch/d2comm.launch">
    <arg name="self_id" value="$(arg self_id)"/>
    <arg name="output" value="screen"/>
  </include>
</launch>

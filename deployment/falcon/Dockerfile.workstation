ARG ONBOARD_SOURCE_IMAGE=onboard_computer:v0.1.1
ARG WORKSTATION_BASE_IMAGE=osrf/ros:humble-desktop-full-jammy

FROM ${ONBOARD_SOURCE_IMAGE} AS as2_source

FROM ${WORKSTATION_BASE_IMAGE} AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=as2_source /root/aerostack2_ws/src/aerostack2/as2_msgs/ \
  /opt/falcon/as2_msgs-source/
COPY deployment/falcon/prepare_workstation.py /opt/falcon/build/prepare_workstation.py
RUN python3 /opt/falcon/build/prepare_workstation.py \
      --source /opt/falcon/as2_msgs-source \
      --output /opt/falcon_workstation_ws \
    && source /opt/ros/humble/setup.bash \
    && cd /opt/falcon_workstation_ws \
    && colcon build --merge-install --executor sequential \
      --base-paths src/as2_msgs \
      --packages-select as2_msgs \
      --cmake-args -DBUILD_TESTING=OFF

FROM ${WORKSTATION_BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG FALCON_SOURCE_DIGEST=unknown
ARG FALCON_REVISION=unknown
LABEL org.opencontainers.image.title="AeroHub FALCON workstation client" \
      org.opencontainers.image.description="Self-contained ROS 2 Humble FALCON acceptance client" \
      io.aerohub.source.digest="${FALCON_SOURCE_DIGEST}" \
      io.aerohub.falcon.revision="${FALCON_REVISION}"

COPY --from=builder /opt/falcon_workstation_ws/install/ \
  /opt/falcon_workstation_ws/install/
COPY --from=as2_source /root/aerostack2_ws/src/aerostack2/as2_msgs/ \
  /opt/falcon/as2_msgs-source/
COPY deployment/falcon/mission.py /opt/falcon/runtime/mission.py
COPY deployment/falcon/run.py /opt/falcon/runtime/run.py
COPY deployment/falcon/source_manifest.py /opt/falcon/runtime/source_manifest.py
COPY deployment/falcon/prepare_workstation.py /opt/falcon/runtime/prepare_workstation.py
COPY simulator/airsim/sensors/uav_as2_sensor_adapter/rpc.py \
  /opt/falcon/runtime/falcon_airsim_rpc.py
COPY deployment/robopi/vendor/msgpack/ /opt/falcon/vendor/msgpack/
COPY deployment/airsim/demos/catora_open_field/sim_startup.py \
  /opt/falcon/runtime/sim_startup.py
COPY deployment/falcon/tests/test_mission.py \
  deployment/falcon/tests/test_run.py \
  deployment/falcon/tests/test_prepare_workstation.py \
  /opt/falcon/tests/
COPY deployment/falcon/entrypoint-workstation.sh /usr/local/bin/aerohub-falcon-workstation

ENV PYTHONPATH=/opt/falcon/vendor:/opt/falcon/runtime \
    AS2_MSGS_SOURCE=/opt/falcon/as2_msgs-source

RUN printf '%s\n' "${FALCON_SOURCE_DIGEST}" > /opt/falcon/source-digest \
    && chmod +x /usr/local/bin/aerohub-falcon-workstation \
    && test ! -e /opt/ros/noetic \
    && test ! -e /opt/falcon_workstation_ws/devel \
    && if grep -RIlE '/home/|/repo|/workspace|catkin_ws' \
         /opt/falcon_workstation_ws/install /opt/falcon/runtime /opt/falcon/vendor \
         > /tmp/host-path-hits; then \
         cat /tmp/host-path-hits; exit 1; \
       fi

ENTRYPOINT ["/usr/local/bin/aerohub-falcon-workstation"]

<?xml version="1.0"?>
<package format="3">
  <name>uav_falcon_adapter</name>
  <version>0.1.0</version>
  <description>FALCON sensor and FollowTimedPath adapter for AeroHub.</description>
  <maintainer email="maintainers@aerohub.invalid">AeroHub maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>falcon_ros2</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>uav_planner_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>

<?xml version="1.0"?>
<package format="3">
  <name>uav_aerovla_planner</name><version>0.1.0</version>
  <description>AeroVLA VLA policy planner (Tool layer) publishing timed trajectories</description>
  <maintainer email="dev@example.com">Aerohub</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>as2_msgs</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>uav_planner_interfaces</exec_depend><exec_depend>uav_inference_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
